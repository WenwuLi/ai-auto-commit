{
  "name": "cotc-ai-auto-commit",
  "displayName": "COTC AI Auto Commit",
  "description": "使用 AI 自动生成高质量的 Git 提交信息",
  "version": "0.0.6",
  "publisher": "menmou",
  "icon": "src/assets/COTC_icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WenwuLi/ai-auto-commit.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ai-commit.generate"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-commit.generate",
        "title": "COTC生成提交信息",
        "category": "AI Commit"
      },
      {
        "command": "ai-commit.generateRules",
        "title": "COTC生成规则文件",
        "category": "AI Commit"
      },
      {
        "command": "ai-commit.config",
        "title": "配置 AI 提交",
        "category": "AI Commit"
      }
    ],
    "keybindings": [
      {
        "command": "ai-commit.generate",
        "key": "ctrl+h ctrl+h",
        "mac": "cmd+h cmd+h",
        "when": "editorTextFocus || !editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AI Auto Commit",
      "properties": {
        "aiCommit.apiProvider": {
          "type": "string",
          "enum": [
            "cursor",
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "Cursor 内置 AI（仅 Cursor 环境，无需填写地址和密钥）",
            "OpenAI 兼容协议（OpenAI、DeepSeek、OpenRouter、硅基流动等聚合商）",
            "Anthropic 兼容协议（Claude 官方或支持 Messages 协议的聚合商）"
          ],
          "default": "cursor",
          "description": "API 协议类型。cursor 使用 Cursor 内置 AI；openai / anthropic 按对应协议请求你填写的模型服务地址"
        },
        "aiCommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "模型服务 API 密钥（协议为 openai 或 anthropic 时必填）"
        },
        "aiCommit.apiEndpoint": {
          "type": "string",
          "default": "",
          "description": "模型服务地址（Base URL），协议为 openai 或 anthropic 时必填。例如 https://api.openai.com/v1、https://openrouter.ai/api/v1。若未带完整路径，插件会按协议自动补全 /chat/completions 或 /messages"
        },
        "aiCommit.model": {
          "type": "string",
          "default": "",
          "description": "模型名称，由所用服务商提供，例如 gpt-4o、claude-3-5-sonnet-20241022、deepseek-chat"
        },
        "aiCommit.customPrompt": {
          "type": "string",
          "default": "",
          "description": "自定义提示词模板（留空使用默认）"
        },
        "aiCommit.maxTokens": {
          "type": "number",
          "default": 1024,
          "description": "最大生成 token 数"
        },
        "aiCommit.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "AI 生成温度（0-2）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && node -e \"require('fs').mkdirSync('release', {recursive: true})\" && npx vsce package --out ./release"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}